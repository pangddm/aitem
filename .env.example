# ================== Kubedoctor 环境配置示例 ==================
# 复制为 .env 并按需填写。所有参数均可通过环境变量/ .env 调整。

# ---- 数据库 PostgreSQL ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
POSTGRES_DB=kubedoctor
POSTGRES_POOL_MIN=2
POSTGRES_POOL_MAX=10

# ---- 数据库 MySQL（用户/会话） ----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=Users

# ---- 缓存 Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=1800
REDIS_MAX_TURNS=20

# ---- 图数据库 Neo4j ----
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password

# ---- 大模型 LLM（DeepSeek 兼容接口） ----
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_FALLBACK_MODEL=deepseek-reasoner
# 知识抽取/记忆提取/重排等使用的模型
EXTRACT_MODEL=deepseek-v4-flash
RERANK_MODEL=deepseek-v4-flash

# ---- Embedding 向量化 ----
EMBEDDING_PROVIDER=jina          # jina | bge | openai
EMBEDDING_DIM=1024
JINA_API_KEY=jina_xxx
JINA_BASE_URL=https://api.jina.ai/v1/embeddings
JINA_MODEL=jina-embeddings-v5-text-small
BGE_MODEL=BAAI/bge-m3

# ---- 视觉/多模态（阿里云 DashScope 兼容接口） ----
DASHSCOPE_API_KEY=sk-ws-xxx
VISION_MODEL=qwen3.5-397b-a17b
VISION_BASE_URL=https://ws-desdcuc07ogrkiwd.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# ---- 邮件告警 SMTP ----
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_SENDER=your_sender@163.com
SMTP_PASSWORD=your_smtp_password
SMTP_RECEIVER=receiver@example.com

# ---- Agent 工作流 ----
# 非测试模式下置信度达到该值自动执行
AUTO_EXEC_CONFIDENCE=0.8
MAX_RETRY_LOOPS=2
MAX_AGENT_ITERATIONS=10
LOOP_NO_PROGRESS_LIMIT=3

# ---- 知识检索 ----
RAG_TOP_K=10
RAG_RERANK_TOP_K=3

# ---- SSH ----
TARGET_HOST=192.168.1.100
TARGET_PORT=22
TARGET_USERNAME=root
TARGET_PASSWORD=your_password
SSH_TIMEOUT=30
SSH_CONNECT_TIMEOUT=8
SSH_POOL_MAX_IDLE=300
SSH_POOL_CLEAN_INTERVAL=60
# 主机凭据加密密钥（留空则不加密）
HOST_ENCRYPTION_KEY=

# ---- 运行模式 ----
# 上传入库成功后是否保留原始文件（true=保留, false=删除）
KEEP_RAW_FILE=false
TEST_MODE=false
LOG_LEVEL=INFO
