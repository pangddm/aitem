# ================== Kubedoctor 环境配置示例 ==================
# 复制为 .env 并按需填写。所有参数均可通过环境变量/ .env 调整。

# ---- 数据库 PostgreSQL ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
POSTGRES_DB=kubedoctor
POSTGRES_POOL_MIN=2
POSTGRES_POOL_MAX=20

# ---- 数据库 MySQL（用户/会话） ----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=Users

# ---- 缓存 Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=1800
REDIS_MAX_TURNS=20

# ---- 图数据库 Neo4j ----
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password

# ---- 大模型 LLM（DeepSeek 兼容接口） ----
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_FALLBACK_MODEL=deepseek-reasoner
# 知识抽取/记忆提取/重排等使用的模型
EXTRACT_MODEL=deepseek-v4-flash
EXTRACT_FALLBACK_MODEL=deepseek-chat
RERANK_MODEL=deepseek-v4-flash
RERANK_FALLBACK_MODEL=deepseek-chat

# ---- Embedding 向量化 ----
EMBEDDING_PROVIDER=jina          # jina | bge | openai
EMBEDDING_DIM=1024
EMBED_BATCH_SIZE=40
EMBED_BATCH_CONCURRENCY=3
JINA_API_KEY=jina_xxx
JINA_BASE_URL=https://api.jina.ai/v1/embeddings
JINA_MODEL=jina-embeddings-v5-text-small
BGE_MODEL=BAAI/bge-m3

# ---- 视觉/多模态（阿里云 DashScope 兼容接口） ----
DASHSCOPE_API_KEY=sk-ws-xxx
VISION_MODEL=qwen3.5-397b-a17b
# 视觉备用模型（主模型失败时自动切换，留空则不启用）
VISION_FALLBACK_MODEL=
VISION_BASE_URL=https://ws-desdcuc07ogrkiwd.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# ---- 邮件告警 SMTP ----
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_SENDER=your_sender@163.com
SMTP_PASSWORD=your_smtp_password
SMTP_RECEIVER=receiver@example.com

# ---- Agent 工作流 ----
# 非测试模式下置信度达到该值自动执行
AUTO_EXEC_CONFIDENCE=0.8
MAX_RETRY_LOOPS=2
MAX_AGENT_ITERATIONS=10
LOOP_NO_PROGRESS_LIMIT=3

# ---- PDF 解析（坐标级页眉页脚过滤）----
PDF_HEADER_RATIO=0.12
PDF_FOOTER_RATIO=0.10
PDF_MIN_REPEAT=2
PDF_MIN_IMAGE_DIM=48
PDF_MIN_IMAGE_AREA=1500
PDF_IMAGE_RENDER_ZOOM=2.0
PDF_OCR_WHOLE_PAGE=true
PDF_TABLE_ENABLED=true
MAX_DOCUMENT_PAGES=500
MAX_DOCUMENT_SIZE_MB=50.0

# ---- 切块 / 清洗 / 抽取 / embedding ----
CHUNK_SIZE=30000
CHUNK_OVERLAP=300
CLEANER_MASK_SENSITIVE=true
EXTRACT_JSON_RETRY=2
INCIDENT_DEDUP_ENABLED=true   # 篇内知识级去重开关
API_RETRY_ATTEMPTS=3
API_RETRY_BASE_DELAY=0.5
API_RETRY_MAX_DELAY=8.0
DB_RETRY_ATTEMPTS=3   # 数据库瞬时错误（连接丢失/死锁/序列化冲突）重试次数
EMBEDDING_CACHE_ENABLED=true

# ---- 知识检索 ----
RAG_TOP_K=10
RAG_RERANK_TOP_K=3
RAG_RERANKER_TYPE=llm
CROSS_ENCODER_MODEL=BAAI/bge-reranker-base
RAG_HYBRID_MODE=rrf
EMBED_TITLE_REPEAT=2
HYBRID_VECTOR_WEIGHT=0.7
HYBRID_KEYWORD_WEIGHT=0.3
RAG_MIN_SCORE=0.0

# ---- SSH ----
TARGET_HOST=192.168.1.100
TARGET_PORT=22
TARGET_USERNAME=root
TARGET_PASSWORD=your_password
SSH_TIMEOUT=30
SSH_CONNECT_TIMEOUT=8
SSH_POOL_MAX_IDLE=300
SSH_POOL_CLEAN_INTERVAL=60
# 主机凭据加密密钥（留空则不加密）
HOST_ENCRYPTION_KEY=

# ---- 运行模式 ----
# 上传入库成功后是否保留原始文件（true=保留, false=删除）
KEEP_RAW_FILE=false
TEST_MODE=false
LOG_LEVEL=INFO

# 聊天中的记忆/工具审计图是否写入 Neo4j（默认开启）；集群拓扑索引始终开启
NEO4J_WRITE_ENABLED=true

# ─── Web 服务：多 worker 并发数 ───
WEB_WORKERS=4
