"""移除 app.js 中所有"思考链"字样"""
import re

path = "web/static/app.js"

with open(path, "r", encoding="utf-8") as f:
    content = f.read()

# 1. 替换 i18n 中的 thinking: "思考链" -> "执行过程"
content = content.replace('thinking: "思考链"', 'thinking: "执行过程"')

# 2. 替换注释中的"思考链"为"执行过程"
content = content.replace("后端思考链格式", "后端执行过程格式")
content = content.replace("如果有思考链数据", "如果有执行过程数据")
content = content.replace("将思考链数据转为执行日志条目", "将执行过程数据转为执行日志条目")
content = content.replace("思考链块会在 renderMessages 中插入", "执行过程块会在 renderMessages 中插入")
content = content.replace("添加执行过程容器（替代思考链）", "添加执行过程容器")
content = content.replace("思考链管理", "执行过程管理")
content = content.replace("收集思考链数据用于持久化", "收集执行过程数据用于持久化")
content = content.replace("思考链块：每个部分先展开滚动展示", "执行过程块：每个部分先展开滚动展示")
content = content.replace("格式化思考链内容", "格式化执行过程内容")
content = content.replace("渲染思考链块", "渲染执行过程块")
content = content.replace("流结束后折叠所有思考链块", "流结束后折叠所有执行过程块")

# 3. 替换用户可见的"💭 思考链" -> "⚡ 执行过程"
content = content.replace('<span>💭 思考链</span>', '<span>⚡ 执行过程</span>')

with open(path, "w", encoding="utf-8") as f:
    f.write(content)

# 验证
with open(path, "r", encoding="utf-8") as f:
    content = f.read()

remaining = [line for line in content.split("\n") if "思考链" in line]
if remaining:
    print(f"STILL {len(remaining)} lines contain 思考链:")
    for line in remaining:
        print(f"  {line.strip()}")
else:
    print("ALL 思考链 removed successfully")